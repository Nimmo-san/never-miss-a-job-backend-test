# Copy this file to .env and fill in real values.
# `.env` is gitignored -- never commit real numbers or tokens.

# The tradesperson's real personal mobile number, in E.164 format
# (e.g. +447123456789). This is who gets dialled when a customer calls the
# dedicated number.
#
# v1 SIMPLIFICATION: single hardcoded number for one tradesperson. Before
# onboarding a second client this MUST become per-client config (e.g. a
# `clients` table keyed by the dedicated Twilio number Twilio reports in the
# webhook's "To" field) instead of one global env var.
TRADESPERSON_NUMBER=+447000000000

# The dedicated "Never Miss a Job" Twilio number that customers call/text.
# Used as the caller ID when dialling the tradesperson, so their phone shows
# the tracked business number rather than a Twilio default.
TWILIO_NUMBER=+447000000001

# How long to ring the tradesperson before treating the call as unanswered.
# Tunable -- 15-20s (4-5 rings) is a reasonable default, not a fixed
# requirement.
RING_TIMEOUT_SECONDS=20

# Copy played/sent to callers and texters. All tunable, not fixed
# requirements -- change the wording to suit the business.
WHISPER_MESSAGE="You have a tracked business enquiry call from Never Miss a Job. Connecting you now."
MISSED_CALL_CALLER_MESSAGE="Sorry, we can't take your call right now. We've logged your call and will be in touch shortly."
SMS_PLACEHOLDER_REPLY="Thanks for your message. We've received it and will get back to you shortly."

# Where the SQLite database file is created (directory is created if missing).
DATABASE_PATH=./data/app.db

# Not read by any Week 1 code path -- Week 1's TwiML responses don't need
# Twilio API credentials. Kept here because you'll need them from the Twilio
# console anyway, and Week 2 will need them for outbound REST calls (sending
# the SMS fallback proactively) and/or validating inbound request signatures.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
